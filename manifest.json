{
  "manifest_version": 3,
  "name": "Dark Any Page",
  "version": "1.0.0",
  "description": "Turns light pages dark, keeps images normal and text legible. Click the toolbar button to force a site on or off.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "sw.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dark.js", "cursor.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": { "default_title": "Dark Any Page", "default_popup": "popup.html" },
  "commands": {
    "toggle-dark": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Toggle dark mode on this site"
    },
    "toggle-cursor": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Toggle the keyboard cursor"
    }
  }
}
